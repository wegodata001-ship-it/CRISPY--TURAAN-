<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layoutDirection="rtl"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="CRISPY"
            android:textColor="@color/crispy_red"
            android:textSize="36sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/statusVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingBottom="8dp"
            android:text="الإصدار"
            android:textColor="@color/ink"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingBottom="16dp"
            android:text="حالة النظام"
            android:textColor="@color/ink"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/updateCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@color/cream"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/updateTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="يتوفر تحديث جديد"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/updateCurrent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/updateNew"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/updateProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:textSize="15sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonUpdate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="تحديث التطبيق"
                android:textSize="18sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/statusService"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"
            android:text="الطباعة في الخلفية: تتفعل بعد فتح التطبيق"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/statusServer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="الخادم: غير متصل"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/statusPrinter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="6dp"
            android:text="الطابعة: غير متصلة"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/statusIp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="6dp"
            android:text="عنوان الطابعة: 192.168.1.80"
            android:textDirection="ltr"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/statusPort"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="6dp"
            android:text="المنفذ: 9100"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/statusLastOrder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="6dp"
            android:text="آخر طلب: —"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/statusLastPrint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="6dp"
            android:text="آخر طباعة: —"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/statusNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="نجاح الإرسال عبر الشبكة لا يثبت خروج الورق."
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonTest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="اختبار الطباعة"
            android:textSize="18sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonAdmin"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="فتح لوحة الإدارة"
            android:textSize="18sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonReconnect"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="إعادة الاتصال"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="20dp"
            android:text="الإعدادات"
            android:textSize="20sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/inputIp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:hint="Printer IP"
            android:inputType="text"
            android:text="192.168.1.80"
            android:textDirection="ltr" />

        <EditText
            android:id="@+id/inputPort"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:hint="Printer Port"
            android:inputType="number"
            android:text="9100"
            android:textDirection="ltr" />

        <EditText
            android:id="@+id/inputApi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="API URL"
            android:inputType="textUri"
            android:text="https://almostafachicken.com"
            android:textDirection="ltr" />

        <EditText
            android:id="@+id/inputToken"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="رمز الوكيل"
            android:inputType="textPassword" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="حفظ"
            android:textSize="18sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonCheckUpdate"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="التحقق من وجود تحديث"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/statusBattery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:text="بعد التثبيت افتح التطبيق مرة واحدة. أندرويد قد يوقف الخدمة بعد إعادة التشغيل حتى تفتحه مرة أخرى."
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
