{
  "name": "mishkah-print-agent",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone MISHKAH kitchen print agent. Café PC only — no website source.",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "package:win": "node scripts/package-windows.mjs",
    "install:crispy": "node scripts/install-crispy-printer.mjs",
    "start": "node dist/agent.cjs",
    "verify": "node dist/agent.cjs --verify"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.8"
  },
  "devDependencies": {
    "esbuild": "^0.25.9"
  }
}
