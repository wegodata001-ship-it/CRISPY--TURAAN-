# Café PC only. Never commit the real token.
# Copy this file to C:\CRISPY-PRINTER\.env
# Do not use this folder for Mishkah.

CRISPY_PRINTER_HOME=C:\\CRISPY-PRINTER
PRINT_AGENT_ENABLED=true
PRINT_AGENT_API_URL=https://portal.crispy-turaan.vercel.app
PRINT_AGENT_TOKEN=replace-with-the-same-token-as-vercel
PRINT_AGENT_ID=crispy-kitchen-pc

PRINTER_IP=192.168.1.80
PRINTER_PORT=9100
PRINTER_TIMEOUT_MS=8000

PRINT_POLL_MS=3000
PRINT_HEARTBEAT_MS=30000

PRINTER_AUTO_CUT=true
PRINTER_BEEP_ON_NEW_ORDER=true
