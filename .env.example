# CRISPY — copy to .env.local and fill with THIS project's Firebase values.
# Never commit real credentials. Never reuse another business's Firebase project.

# --- Firebase client (required) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# After Console → Storage → Get Started, copy the bucket name exactly
# (usually PROJECT_ID.firebasestorage.app or PROJECT_ID.appspot.com)
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional Analytics
# NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# --- Firebase Admin SDK (server-only — required to create the first admin) ---
# Firebase Console → Project settings → Service accounts → Generate new private key
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
# Alternative: entire service-account JSON as one line
# FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Public URLs (set these on Vercel Production + Preview) ---
NEXT_PUBLIC_ADMIN_URL=https://portal.crispy-turaan.vercel.app
NEXT_PUBLIC_CUSTOMER_URL=https://almostafachicken.com
NEXT_PUBLIC_MENU_URL=https://menu.almostafachicken.com
NEXT_PUBLIC_ORDER_URL=https://almostafachicken.com
NEXT_PUBLIC_SITE_URL=https://almostafachicken.com
NEXT_PUBLIC_PUBLIC_HOST=almostafachicken.com
NEXT_PUBLIC_PORTAL_HOST=portal.crispy-turaan.vercel.app
NEXT_PUBLIC_MENU_HOST=menu.almostafachicken.com
NEXT_PUBLIC_PORTAL_URL=https://portal.crispy-turaan.vercel.app
# Optional QR overrides (default to MENU_URL / ORDER_URL)
# NEXT_PUBLIC_QR_LINK_1=
# NEXT_PUBLIC_QR_LINK_2=

# --- First admin (created once when no Admin user exists) ---
# Do not commit a real password. Set only in .env.local.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=CRISPY Admin

# --- Kitchen printer (local Print Agent only — Vercel cannot open LAN TCP) ---
# Single source of truth for the restaurant PC agent:
PRINTER_IP=192.168.1.80
PRINTER_PORT=9100
PRINTER_TIMEOUT_MS=8000
ENABLE_LOCAL_PRINTER_TEST=false
PRINT_AUTO_NEW_ORDERS=true
PRINT_STORE_ID=crispy
PRINT_AGENT_TOKEN=
PRINT_AGENT_ENABLED=true
PRINTER_AUTO_CUT=true
PRINTER_BEEP_ON_NEW_ORDER=true

# --- Email (optional — server-only) ---
MAIL_PROVIDER=NONE
BREVO_BASE_URL=https://api.brevo.com/v3
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=CRISPY
BREVO_REPLY_TO=
MISHKAH_NOTIFICATION_EMAIL=
MISHKAH_ADMIN_EMAIL=
