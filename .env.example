# CRISPY — copy to .env.local and fill with THIS project's Firebase values.
# Never commit real credentials. Never reuse another business's Firebase project.

# --- Firebase client (required) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# After Console → Storage → Get Started, copy the bucket name exactly
# (usually PROJECT_ID.firebasestorage.app or PROJECT_ID.appspot.com)
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional Analytics
# NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# --- Firebase Admin SDK (server-only — required to create the first admin) ---
# Firebase Console → Project settings → Service accounts → Generate new private key
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
# Alternative: entire service-account JSON as one line
# FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Public URLs (set these on Vercel Production + Preview) ---
# Local crispy-staging only: set NEXT_PUBLIC_CRISPY_STAGING_MODE=true and use
# http://localhost:3000 for public *URL* vars. Staging mode never falls back to
# the live customer domain. Leave the flag unset/false in Production.
# Do NOT set MENU_HOST/PORTAL_HOST to "localhost" — that makes middleware treat
# the whole app as menu/portal. On local staging those hosts are ignored for
# localhost anyway; prefer unused local labels such as menu.staging.local.
# NEXT_PUBLIC_CRISPY_STAGING_MODE=false
NEXT_PUBLIC_ADMIN_URL=https://portal.crispy-turaan.vercel.app
NEXT_PUBLIC_CUSTOMER_URL=https://almostafachicken.com
NEXT_PUBLIC_MENU_URL=https://menu.almostafachicken.com
NEXT_PUBLIC_ORDER_URL=https://almostafachicken.com
NEXT_PUBLIC_SITE_URL=https://almostafachicken.com
NEXT_PUBLIC_PUBLIC_HOST=almostafachicken.com
NEXT_PUBLIC_PORTAL_HOST=portal.crispy-turaan.vercel.app
NEXT_PUBLIC_MENU_HOST=menu.almostafachicken.com
NEXT_PUBLIC_PORTAL_URL=https://portal.crispy-turaan.vercel.app
# Optional QR overrides (default to MENU_URL / ORDER_URL)
# NEXT_PUBLIC_QR_LINK_1=
# NEXT_PUBLIC_QR_LINK_2=

# --- First admin (created once when no Admin user exists) ---
# Do not commit a real password. Set only in .env.local.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=CRISPY Admin

# --- Kitchen printer (local Print Agent only — Vercel cannot open LAN TCP) ---
# Single source of truth for the restaurant PC agent:
PRINTER_IP=192.168.1.80
PRINTER_PORT=9100
PRINTER_TIMEOUT_MS=8000
ENABLE_LOCAL_PRINTER_TEST=false
PRINT_AUTO_NEW_ORDERS=true
PRINT_STORE_ID=crispy
PRINT_AGENT_TOKEN=
PRINT_AGENT_ENABLED=true
PRINTER_AUTO_CUT=true
PRINTER_BEEP_ON_NEW_ORDER=true

# --- Phone OTP / Telnyx ---
# Temporarily disabled in the app (checkout uses phone format validation only).
# Keep any existing secrets in Vercel unused until OTP is re-enabled later.
# TELNYX_API_KEY=
# TELNYX_MESSAGING_PROFILE_ID=
# TELNYX_SENDER_ID=CRISPY
# PHONE_OTP_STAGING_MOCK=false

# --- Email (optional — server-only) ---
MAIL_PROVIDER=NONE
BREVO_BASE_URL=https://api.brevo.com/v3
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=CRISPY
BREVO_REPLY_TO=
MISHKAH_NOTIFICATION_EMAIL=
MISHKAH_ADMIN_EMAIL=

# --- Hyp Pay / MAX (server-only — credit card hosted page) ---
# Never put KEY/PassP/Masof in NEXT_PUBLIC_* vars. Never commit real values.
# Put production secrets only in Vercel → Production → Environment Variables (Sensitive).
#
# Flow: checkout persists unpaid order + hypPaymentIntent → APISign SIGN → customer pays →
# browser hits /api/payments/hyp/return → server APISign VERIFY → mark paid once → kitchen once.
#
HYP_PAYMENTS_ENABLED=false
#
# Local crispy-staging ONLY — mock hosted page without real Hyp / no keys.
# Requires NODE_ENV=development, NEXT_PUBLIC_CRISPY_STAGING_MODE=true,
# Firebase client+admin = crispy-staging. Leave false on Vercel/Production.
HYP_STAGING_MOCK=false
#
# Staging track (crispy-staging): see env/hyp-crispy-staging-test.example
#
# Production track (crispy-d0bf7): requires BOTH flags — never enable by credentials alone.
# See env/hyp-crispy-production.example
# HYP_PAY_PRODUCTION_ENABLED=false
HYP_PAY_PRODUCTION_ENABLED=false
HYP_PAY_BASE_URL=https://pay.hyp.co.il/p/
HYP_PAY_MASOF=
HYP_PAY_KEY=
HYP_PAY_PASSP=
# Coin: 1=ILS (default), 2=USD, 3=EUR, 4=GBP — Amount uses major units (e.g. 47.30), not agorot
HYP_PAY_COIN=1
HYP_PAY_PAGE_LANG=HEB
# Hyp Portal Success + Fail (production HTTPS — same CRISPY return route):
# https://almostafachicken.com/api/payments/hyp/return
HYP_PAY_SUCCESS_URL=https://almostafachicken.com/api/payments/hyp/return
HYP_PAY_FAIL_URL=https://almostafachicken.com/api/payments/hyp/return
