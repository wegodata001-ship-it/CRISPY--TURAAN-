# Firebase Admin SDK (server-side only — NEVER commit real values)
#
# How to get credentials:
# 1. Firebase Console → Project "mshkah" → ⚙ Project Settings
# 2. Tab "Service accounts" → "Generate new private key"
# 3. Download the JSON file
#
# Option A — paste from JSON (recommended):
# FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@mshkah.iam.gserviceaccount.com
# FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
#
# Option B — entire JSON as one line:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"mshkah",...}
#
# ⚠️ NOT your Gmail password! NOT admin login password!
# The client_email ends with @mshkah.iam.gserviceaccount.com (not @gmail.com)

FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Public storefront (QR codes, Open Graph). Must be the live site — never localhost.
NEXT_PUBLIC_SITE_URL=https://mshkah.vercel.app

# Local thermal printer (LAN only — never reachable from Vercel)
PRINTER_IP=192.168.1.30
PRINTER_PORT=9100
PRINTER_TIMEOUT_MS=8000
# Optional Epson ESC t index for Hebrew CP862 (model-dependent)
# PRINTER_HEBREW_CODEPAGE_INDEX=36
# Required in production to expose /api/printer/* test routes (keep false on Vercel)
ENABLE_LOCAL_PRINTER_TEST=false

# Auto-bootstrap first admin (created once if no admin exists)
ADMIN_BOOTSTRAP_EMAIL=admin@mishkat.cafe
ADMIN_BOOTSTRAP_PASSWORD=ChangeMe2026!
ADMIN_BOOTSTRAP_NAME=MISHKAT Admin
