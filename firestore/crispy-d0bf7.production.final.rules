// =============================================================================
// FINAL production rules for crispy-d0bf7 (NOT published by this prep step).
// Base: LIVE Console rules (see crispy-d0bf7.live.snapshot.rules)
// Plus: Hyp / MAX payment locks + Admin-SDK-only collections used by current app.
//
// Intentional hardening (required for safe Hyp):
//   LIVE had:  allow create: if true; on /orders
//   FINAL has: staff cash tickets only + payment field locks; guest checkout
//              continues via Admin SDK (/api/orders/checkout) which bypasses rules.
//
// Preserved unchanged from LIVE: categories, products, customers, banners,
// settings, translations, assistant, users, connection-test, modifiers,
// business_rules, suggestions, inventory_links, pdf*, print*, costing*.
// =============================================================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isActiveUser() {
      return isSignedIn() && userDoc().data.active == true;
    }

    function isStaff() {
      return isActiveUser() && userDoc().data.role in ['Admin', 'Manager', 'Employee'];
    }

    function isAdmin() {
      return isStaff() && userDoc().data.role == 'Admin';
    }

    match /categories/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /products/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /customers/{id} {
      allow read: if isStaff() || id == 'guest-checkout';
      allow create: if isStaff() || id == 'guest-checkout';
      allow update: if isStaff() || id == 'guest-checkout';
      allow delete: if isStaff();
    }

    function orderRequiresOnlinePayment() {
      return resource.data.get('requiresOnlinePayment', false) == true
        || resource.data.get('awaitingHypPayment', false) == true;
    }

    function orderPaymentIsPaid() {
      return resource.data.get('paymentStatus', 'pending') == 'paid';
    }

    function kitchenWorkflowStatus(status) {
      return status in ['preparing', 'ready', 'delivered', 'confirmed'];
    }

    // Payment confirmation fields are Admin SDK / Hyp VERIFY only.
    function orderPaymentFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'paymentStatus',
        'requiresOnlinePayment',
        'awaitingHypPayment',
        'paymentFlow',
        'hypOrderRef',
        'hypTransactionId',
        'paidAt',
        'phoneVerified',
        'phoneVerifiedAt'
      ]);
    }

    function staffMayUpdateOrderStatus() {
      let nextStatus = request.resource.data.get('status', resource.data.status);
      // Cancel and non-kitchen statuses stay allowed for unpaid online-card orders.
      return !kitchenWorkflowStatus(nextStatus)
        || !orderRequiresOnlinePayment()
        || orderPaymentIsPaid();
    }

    function staffCreateHasNoTrustedPaymentMarks() {
      return request.resource.data.get('requiresOnlinePayment', false) != true
        && request.resource.data.get('awaitingHypPayment', false) != true
        && request.resource.data.get('paymentFlow', '') != 'hyp_online'
        && request.resource.data.get('paymentStatus', 'pending') != 'paid'
        && request.resource.data.get('hypTransactionId', null) == null
        && request.resource.data.get('paidAt', null) == null;
    }

    match /orders/{id} {
      allow read: if isStaff();
      // Guest storefront checkout: Admin SDK only (/api/orders/checkout).
      // Staff may create cash/legacy tickets without trusted paid stamps.
      allow create: if isStaff() && staffCreateHasNoTrustedPaymentMarks();
      allow delete: if isStaff();
      allow update: if isStaff()
        && orderPaymentFieldsUnchanged()
        && staffMayUpdateOrderStatus();
    }

    // Admin-SDK-only collections (client denied). Safe additive vs LIVE default-deny.
    match /phoneOtps/{id} {
      allow read, write: if false;
    }

    match /phoneOtpIndex/{id} {
      allow read, write: if false;
    }

    match /phoneOtpIps/{id} {
      allow read, write: if false;
    }

    match /phoneVerifications/{id} {
      allow read, write: if false;
    }

    match /orderCheckoutRequests/{id} {
      allow read, write: if false;
    }

    match /hypPaymentIntents/{id} {
      allow read, write: if false;
    }

    match /hypPaymentAuditLogs/{id} {
      allow read, write: if false;
    }

    match /coupons/{id} {
      allow read, write: if false;
    }

    match /couponRedemptions/{id} {
      allow read, write: if false;
    }

    match /couponCheckoutRequests/{id} {
      allow read, write: if false;
    }

    match /couponCustomerUses/{id} {
      allow read, write: if false;
    }

    match /banners/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /settings/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /ui_translations/{locale} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /assistant/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isStaff());
      allow write: if false;
    }

    match /connection-test/{id} {
      allow read, write: if true;
    }

    match /modifier_groups/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /modifier_options/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /product_modifier_groups/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Same staff pattern as sibling modifier collections (missing on LIVE today).
    match /category_modifier_groups/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /product_addon_exclusions/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /product_modifier_options/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /business_rules/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /suggestions/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /inventory_links/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /pdfMenuTemplates/{id} {
      allow read, write: if isStaff();
    }

    match /pdfMenuCategorySettings/{id} {
      allow read, write: if isStaff();
    }

    match /pdfMenuProductSettings/{id} {
      allow read, write: if isStaff();
    }

    match /pdfMenuPages/{id} {
      allow read, write: if isStaff();
    }

    match /printJobs/{id} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /printAgentHeartbeats/{id} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /ingredients/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /ingredientPriceHistory/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /productRecipes/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /costingSettings/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }
  }
}
